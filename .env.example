# --- RecipeDB + FlavorDB (CoSyLab / Foodoscope) ---
API_BASE=http://cosylab.iiitd.edu.in:6969
API_KEY=put_YOUR_OWN_hackathon_key_here
CUISINE_REGION=Indian Subcontinent

# --- CocktailDB ---
# off            : drink ideas fall back to sample data
# foodoscope     : the hackathon's CocktailDB - set COCKTAIL_PATH (+ COCKTAIL_PARAM) from the official docs
# thecocktaildb  : the public thecocktaildb.com API (free test key "1" works for development)
COCKTAIL_MODE=thecocktaildb
COCKTAIL_PATH=
COCKTAIL_PARAM=ingredient
THECOCKTAILDB_KEY=1

CACHE_TTL_SECONDS=86400
UPSTREAM_TIMEOUT=10
